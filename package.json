{
  "name": "@swaraj792725/git-diff-context-packer",
  "version": "1.0.0",
  "description": "Zero-dependency Git diff parser, patch analyzer, and token-budgeted AI prompt context generator for Claude, Gemini, and Cursor code reviews.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "git-diff-context-packer": "./dist/cli.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "git-diff",
    "patch-parser",
    "ai-code-review",
    "token-savings",
    "prompt-generator",
    "vibe-coding",
    "claude",
    "typescript",
    "zero-dependency"
  ],
  "author": "Swaraj <swaraj792725@github.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swaraj792725/git-diff-context-packer.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.3.5",
    "typescript": "^5.3.3",
    "vitest": "^2.1.8"
  }
}
